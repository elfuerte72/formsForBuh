# --- Required ---
ANTHROPIC_API_KEY=sk-ant-xxx
WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- Optional (defaults in app/config.py) ---
LOG_LEVEL=INFO
LOG_FORMAT=json            # 'pretty' for local dev
ANTHROPIC_MODEL=claude-sonnet-4-6
MAX_IMAGE_DPI=200
MAX_DOWNLOAD_BYTES=26214400   # 25 MB
HTTP_TIMEOUT_SECONDS=30
