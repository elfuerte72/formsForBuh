# --- Required ---
ANTHROPIC_API_KEY=sk-ant-xxx

# Google Sheet where UPD rows are appended.
# Take the ID from the URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SHEET_ID=your-google-sheet-id

# Service Account JSON credentials as a SINGLE LINE.
# Escape newlines inside private_key as \n.
# Share the target sheet with the service account email (Editor role).
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"sa-name@project.iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}

# --- Optional (defaults in app/config.py) ---
LOG_LEVEL=INFO
LOG_FORMAT=json            # 'pretty' for local dev
ANTHROPIC_MODEL=claude-sonnet-4-6
MAX_IMAGE_DPI=200
MAX_UPLOAD_BYTES=26214400  # 25 MB
HTTP_TIMEOUT_SECONDS=30

# Reconciliation (1С «Сводка») is paused for stage 1 — the form only uploads УПД
# and the register just accumulates. The reconciliation write is now
# non-destructive (annotates rows in place, preserves manual statuses), so
# flipping this to true (and RECON_ENABLED in app/static/index.html) is safe
# whenever the «Сводка» tab is wanted back.
RECONCILIATION_ENABLED=false

# Google Drive archival of the original scan (feature-flagged, off by default).
# When on, each uploaded УПД is stored in <DRIVE_FOLDER_ID>/<dd.mm.yyyy>/ and the
# webViewLink lands in the «Файл» column (M).
#
# Auth is OAuth *user*, NOT the service account: a service account has no Drive
# storage quota, so any file it creates is rejected (sharing a folder with it
# doesn't help — the new file would be owned by the SA). Uploads run as a real
# user via a refresh token. Get it once with:
#     uv run python scripts/drive_authorize.py path/to/client_secret.json
# then paste the three values below and set DRIVE_ENABLED=true.
DRIVE_ENABLED=false
DRIVE_FOLDER_ID=
DRIVE_OAUTH_CLIENT_ID=
DRIVE_OAUTH_CLIENT_SECRET=
DRIVE_OAUTH_REFRESH_TOKEN=
